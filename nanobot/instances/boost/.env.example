# Nanobot/boost secrets.env — TEMPLATE / documentation only.
#
# THE LIVE FILE LIVES ON THE VPS at /opt/nanobot-boost/secrets.env (chmod 600).
# This .env.example documents the required keys; it is NEVER copied to the VPS
# by any script. Edit /opt/nanobot-boost/secrets.env directly via ssh.
#
# On first bootstrap, populate from the OpenClaw backup tarball
# (~/openclaw-secrets-backup-2026-05-18.tar.gz → opt/openclaw/instances/boost/.env)
# applying this rename: TELEGRAM_BOT_TOKEN → TELEGRAM_TOKEN.

# --- LLM provider ---
# OpenRouter API key. Same as personal is fine (per-account, not per-app).
OPENROUTER_API_KEY=

# --- Channels ---
# Boost has its own dedicated Telegram bot (separate from the personal profile's bot).
# Token is in the backup as TELEGRAM_BOT_TOKEN — copy under the new name TELEGRAM_TOKEN.
TELEGRAM_TOKEN=

# Numeric Telegram user IDs (NOT @usernames).
TELEGRAM_ALLOWED_USER_1=     # CEO
TELEGRAM_ALLOWED_USER_2=     # second admin

# Boost supergroup ID (negative integer). Documentation only — nanobot has no
# per-group whitelist; group access is gated by allowFrom + group_policy=mention.
TELEGRAM_GROUP_ID=

# --- Web search ---
TAVILY_API_KEY=

# --- Google integration via gog CLI (admin@example.com) ---
# Keyring + client_secret already exist in the backup at:
#   root/.openclaw-boost/config/gogcli/keyring/
#   root/.openclaw-boost/client_secret_<project-number>-*.json
# Restore both during VPS bootstrap; do NOT re-run `gog auth add`.
GOG_ACCOUNT=admin@example.com
GOG_KEYRING_PASSWORD=

# --- AgendaPro ---
# Two-step auth (Cognito JWT + Rails session cookie) — see agendapro skill.
# Cookie + token persist in workspace/.agendapro-{token,cookies.txt}, mounted
# at /opt/nanobot-boost/nanobot-data/workspace/ on host.
AGENDAPRO_EMAIL=
AGENDAPRO_PASSWORD=
