# Nanobot secrets.env — TEMPLATE / documentation only.
#
# THE LIVE FILE LIVES ON THE VPS at /opt/nanobot/secrets.env (chmod 600).
# This .env.example is the documented list of required keys; it is NEVER
# copied to the VPS by any script. Edit /opt/nanobot/secrets.env directly
# via ssh when you need to rotate credentials.
#
# scripts/deploy-nanobot.sh refuses to deploy if /opt/nanobot/secrets.env
# is missing any of these keys.

# --- LLM provider ---
# OpenRouter API key for all LLM calls (Haiku/Sonnet/Gemini per modelPresets in config.json.template).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Channels ---
# Telegram bot token from @BotFather. Used by the gateway to poll for messages.
TELEGRAM_TOKEN=

# Numeric Telegram user IDs (NOT @usernames). Both are substituted into
# channels.telegram.allowFrom in config.json.template — these users may DM
# the bot OR @mention it in any group the bot has been added to.
# Find your ID by DMing @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_1=
TELEGRAM_ALLOWED_USER_2=

# Telegram group ID where the bot operates (negative integer for supergroups).
# Note: nanobot's TelegramConfig has no native per-group whitelist field — this
# is persisted here for documentation only. Group access is gated by:
#   (a) bot being added to the group, AND
#   (b) sender being in allowFrom (the USER_1/USER_2 above), AND
#   (c) group_policy=mention (set in config.json.template), so the bot only
#       responds when someone @mentions it in the group.
# If you want to restrict the bot to ONLY this group, that's a custom feature
# we'd need to add (currently the bot will respond to @mentions in any group
# it's been added to, by allowlisted users).
TELEGRAM_GROUP_ID=

# --- Web search ---
# Tavily API key. Used by nanobot's built-in web_search tool.
# Free tier: 1,000 searches/month. https://tavily.com
TAVILY_API_KEY=

# --- Google integration via gog CLI ---
# Default Google account for gog (calendar/gmail/drive/sheets).
# Format: an email like me@example.com that you've run through
#   docker exec -it nanobot gog auth add <email> --services gmail,drive,sheets,calendar --manual
GOG_ACCOUNT=

# Passphrase for the encrypted gog keyring at /home/nanobot/.config/gogcli/keyring/.
# Set during the initial `gog auth add` interactive prompt.
# Without this, every gog call would hang waiting for a TTY passphrase prompt.
GOG_KEYRING_PASSWORD=

# --- TrainingPeaks (currently NOT working end-to-end — see training-coach skill) ---
# Kept here for completeness; required by the training-coach skill if/when it's fixed.
TRAINING_PEAKS_USERNAME=
TRAINING_PEAKS_PASSWORD=

# Bearer guard for the cuadre-mcp sidecar. The config template injects this as the
# Authorization header on http://cuadre-mcp:8970/mcp; without it the server 401s
# and none of the mcp_cuadre_* tools reach the agent.
CUADRE_MCP_HTTP_TOKEN=
